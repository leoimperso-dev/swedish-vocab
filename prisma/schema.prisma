generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WordType {
  VERB
  NOUN_EN // Swedish common-gender noun ("en bok")
  NOUN_ETT // Swedish neuter noun ("ett hus")
  NOUN // Genderless noun (English)
  ADJECTIVE
  ADVERB
  FUNCTION
  PHRASE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("Europe/Brussels")
  // Interface language: "fr" | "sv" | "en"
  nativeLanguage String   @default("fr")
  // Language being studied. The (nativeLanguage, learningLanguage) couple is the
  // user's course and resolves to a content pair — see lib/courses.ts
  learningLanguage String @default("sv")
  // Self-declared CEFR level per learned language: { "sv": "A2", "en": "B2" }.
  // Unset means "not asked yet" — the app prompts before the first session.
  levels        Json     @default("{}")
  xp            Int       @default(0)
  level         Int       @default(1)
  streakCurrent Int       @default(0)
  streakBest    Int       @default(0)
  freezeCount   Int       @default(2) // streak freezes available (max 2, +1 every 7-day milestone)
  dailyGoalXp   Int       @default(3)
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  wordProgress  UserWord[]
  studySessions StudySession[]
  achievements  UserAchievement[]
  favorites     Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Word {
  id       String   @id @default(cuid())
  // Content pair this word belongs to: "sv-fr" | "en-fr" (lib/courses.ts)
  pair     String   @default("sv-fr")
  // Headword in the pair's `term` language, and its `translation`-language gloss
  term        String
  translation String
  wordType WordType @default(OTHER)
  category String?
  // sv verb: {present,preterit,supine} | en verb: {past,pastParticiple}
  // noun: {plural} | adj: {ett,plural,comparative,superlative}
  forms    Json?
  source   String?  // "swedish_txt" | "core_3000"
  frequencyRank Int? // real-world rank from OpenSubtitles corpus (1 = most common)
  // False for entries that make no exercise: term == translation, a Wiktionary
  // gloss that is a definition rather than a translation, an inflected form the
  // curated lists already teach, or a rank poisoned by contraction splitting.
  // They stay in the dictionary, the list and search — only sessions skip them.
  // Recomputed by scripts/mark-studyable.ts after each seed.
  studyable Boolean @default(true)
  // CEFR band derived from frequencyRank — see lib/cefr.ts. Filters which new
  // words a learner is served, based on the level they declared for the language.
  cefr     String?  // "A1" | "A2" | "B1" | "B2" | "C1" | "C2"
  // { translations: string[], context?: string, usage?: [{term, translation}] }
  details  Json?
  // Tatoeba example sentences (CC-BY): [{ term, translation?, blank }] — blank = surface form to hide in cloze
  examples Json?
  createdAt DateTime @default(now())

  userProgress UserWord[]
  favorites    Favorite[]

  @@unique([pair, term, wordType, source], map: "Word_pair_term_wordType_source_key")
  @@index([pair, frequencyRank], map: "Word_pair_frequencyRank_idx")
  @@index([pair, studyable, frequencyRank], map: "Word_pair_studyable_rank_idx")
  @@index([pair, cefr, frequencyRank], map: "Word_pair_cefr_rank_idx")
}

model Story {
  id              String   @id @default(cuid())
  pair            String   @default("sv-fr") // content pair (lib/courses.ts)
  slug            String   @unique
  title           String // title in the pair's `term` language
  titleTranslated String
  level           String // "beginner" | "intermediate" | "expert" | "dialogue"
  body            String // `term`-language text, paragraphs separated by \n\n
  wordCount       Int
  createdAt       DateTime @default(now())

  @@index([pair])
}

// Turn-by-turn conversations for the speaking exercise: the app voices the
// `them` turns, the learner says the `you` ones out loud (its French
// translation is shown as the instruction).
model Dialogue {
  id              String   @id @default(cuid())
  pair            String   @default("sv-fr") // content pair (lib/courses.ts)
  slug            String   @unique
  title           String // title in the pair's `term` language
  titleTranslated String
  level           String // "beginner" | "intermediate" | "expert"
  // [{ speaker: "them" | "you", text, translation }]
  turns           Json
  createdAt       DateTime @default(now())

  @@index([pair, level])
}

model GrammarLesson {
  id        String   @id @default(cuid())
  pair      String   @default("sv-fr") // content pair (lib/courses.ts)
  slug      String   @unique
  // Lessons teach the pair's `term` language and are written in its
  // `translation` language, so only learners of `term` are served them.
  title     String
  category  String // category label ("Verbes", "Noms & articles"...)
  order     Int // global pedagogical order (also orders categories)
  body      String // restricted markdown (##, -, **, > example lines)
  createdAt DateTime @default(now())

  @@index([pair, order])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model UserWord {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  // "SV_FR" = prompted in Swedish, answered in French | "FR_SV" = the reverse.
  // Each direction has its own SM-2 progression.
  direction      String    @default("SV_FR")
  // SM-2 fields
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  nextReview     DateTime  @default(now())
  // Stats
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  approxCount    Int       @default(0)
  lastResult     String?   // "correct" | "approximate" | "incorrect"
  lastStudied    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId, direction])
}

model StudySession {
  id           String    @id @default(cuid())
  userId       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  wordsStudied Int       @default(0)
  wordsCorrect Int       @default(0)
  wordsApprox  Int       @default(0)
  xpGained     Int       @default(0)
  bestCombo    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xpReward    Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}
