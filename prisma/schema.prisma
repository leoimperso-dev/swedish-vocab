generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WordType {
  VERB
  NOUN_EN
  NOUN_ETT
  ADJECTIVE
  ADVERB
  FUNCTION
  PHRASE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("Europe/Brussels")
  xp            Int       @default(0)
  level         Int       @default(1)
  streakCurrent Int       @default(0)
  streakBest    Int       @default(0)
  freezeCount   Int       @default(2) // streak freezes available (max 2, +1 every 7-day milestone)
  dailyGoalXp   Int       @default(30)
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  wordProgress  UserWord[]
  studySessions StudySession[]
  achievements  UserAchievement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Word {
  id       String   @id @default(cuid())
  swedish  String
  french   String
  wordType WordType @default(OTHER)
  category String?
  // verbe: {present,preterit,supine} | nom: {plural} | adj: {ett,plural,comparative,superlative}
  forms    Json?
  source   String?  // "swedish_txt" | "core_3000"
  frequencyRank Int? // real-world rank from OpenSubtitles corpus (1 = most common)
  // { translations: string[], context?: string, usage?: [{sv, fr}] }
  details  Json?
  createdAt DateTime @default(now())

  userProgress UserWord[]

  @@unique([swedish, wordType, source])
  @@index([frequencyRank])
}

model UserWord {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  // SM-2 fields
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  nextReview     DateTime  @default(now())
  // Stats
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  approxCount    Int       @default(0)
  lastResult     String?   // "correct" | "approximate" | "incorrect"
  lastStudied    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model StudySession {
  id           String    @id @default(cuid())
  userId       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  wordsStudied Int       @default(0)
  wordsCorrect Int       @default(0)
  wordsApprox  Int       @default(0)
  xpGained     Int       @default(0)
  bestCombo    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xpReward    Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}
