generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WordType {
  VERB
  NOUN_EN // Swedish common-gender noun ("en bok")
  NOUN_ETT // Swedish neuter noun ("ett hus")
  NOUN // Genderless noun (English)
  ADJECTIVE
  ADVERB
  FUNCTION
  PHRASE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Set only for accounts created with the email/password provider. A Google-only
  // account has none until its owner asks for a password through the reset flow.
  passwordHash  String?
  timezone      String    @default("Europe/Brussels")
  // Interface language: "fr" | "sv" | "en"
  nativeLanguage String   @default("fr")
  // Language being studied. The (nativeLanguage, learningLanguage) couple is the
  // user's course and resolves to a content pair — see lib/courses.ts
  learningLanguage String @default("sv")
  // Self-declared CEFR level per learned language: { "sv": "A2", "en": "B2" }.
  // Unset means "not asked yet" — the app prompts before the first session.
  levels        Json     @default("{}")
  xp            Int       @default(0)
  level         Int       @default(1)
  streakCurrent Int       @default(0)
  streakBest    Int       @default(0)
  freezeCount   Int       @default(2) // streak freezes available (max 2, +1 every 7-day milestone)
  dailyGoalXp   Int       @default(15)
  lastStudiedAt DateTime?
  // Last time the app was opened, study or not — shown on a public profile
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  wordProgress  UserWord[]
  studySessions StudySession[]
  achievements  UserAchievement[]
  favorites     Favorite[]
  errorReports  ErrorReport[]
  chatUsage     ChatUsage[]
  duelsSent     Duel[]        @relation("DuelChallenger")
  duelsReceived Duel[]        @relation("DuelOpponent")
  duelRounds    DuelRound[]
  pushSubs      PushSubscription[]
  weeklyWins    WeeklyWin[]
  resetTokens   PasswordResetToken[]
}

// Password reset links. Only the SHA-256 of the token is stored, so a database
// dump cannot be replayed as a reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Word {
  id       String   @id @default(cuid())
  // Content pair this word belongs to: "sv-fr" | "en-fr" (lib/courses.ts)
  pair     String   @default("sv-fr")
  // Headword in the pair's `term` language, and its `translation`-language gloss
  term        String
  translation String
  wordType WordType @default(OTHER)
  category String?
  // sv verb: {present,preterit,supine} | en verb: {past,pastParticiple}
  // noun: {plural} | adj: {ett,plural,comparative,superlative}
  forms    Json?
  source   String?  // "swedish_txt" | "core_3000"
  frequencyRank Int? // real-world rank from OpenSubtitles corpus (1 = most common)
  // False for entries that make no exercise: term == translation, a Wiktionary
  // gloss that is a definition rather than a translation, an inflected form the
  // curated lists already teach, or a rank poisoned by contraction splitting.
  // They stay in the dictionary, the list and search — only sessions skip them.
  // Recomputed by scripts/mark-studyable.ts after each seed.
  studyable Boolean @default(true)
  // CEFR band derived from frequencyRank — see lib/cefr.ts. Filters which new
  // words a learner is served, based on the level they declared for the language.
  cefr     String?  // "A1" | "A2" | "B1" | "B2" | "C1" | "C2"
  // { translations: string[], context?: string, usage?: [{term, translation}] }
  details  Json?
  // Tatoeba example sentences (CC-BY): [{ term, translation?, blank }] — blank = surface form to hide in cloze
  examples Json?
  createdAt DateTime @default(now())

  userProgress UserWord[]
  favorites    Favorite[]
  errorReports ErrorReport[]

  @@unique([pair, term, wordType, source], map: "Word_pair_term_wordType_source_key")
  @@index([pair, frequencyRank], map: "Word_pair_frequencyRank_idx")
  @@index([pair, studyable, frequencyRank], map: "Word_pair_studyable_rank_idx")
  @@index([pair, cefr, frequencyRank], map: "Word_pair_cefr_rank_idx")
}

model Story {
  id              String   @id @default(cuid())
  pair            String   @default("sv-fr") // content pair (lib/courses.ts)
  slug            String   @unique
  title           String // title in the pair's `term` language
  titleTranslated String
  level           String // "beginner" | "intermediate" | "expert" | "dialogue"
  body            String // `term`-language text, paragraphs separated by \n\n
  // Same text in the pair's `translation` language, paragraph for paragraph.
  // Only set on bilingual sources (real-world prose); a written-for-learners
  // story leaves it null and is read with the word popover alone.
  bodyTranslated  String?
  wordCount       Int
  createdAt       DateTime @default(now())

  @@index([pair])
}

// Turn-by-turn conversations for the speaking exercise: the app voices the
// `them` turns, the learner says the `you` ones out loud (its French
// translation is shown as the instruction).
model Dialogue {
  id              String   @id @default(cuid())
  pair            String   @default("sv-fr") // content pair (lib/courses.ts)
  slug            String   @unique
  title           String // title in the pair's `term` language
  titleTranslated String
  level           String // "beginner" | "intermediate" | "expert"
  // [{ speaker: "them" | "you", text, translation }]
  turns           Json
  createdAt       DateTime @default(now())

  @@index([pair, level])
}

model GrammarLesson {
  id        String   @id @default(cuid())
  pair      String   @default("sv-fr") // content pair (lib/courses.ts)
  slug      String   @unique
  // Lessons teach the pair's `term` language and are written in its
  // `translation` language, so only learners of `term` are served them.
  title     String
  category  String // category label ("Verbes", "Noms & articles"...)
  order     Int // global pedagogical order (also orders categories)
  body      String // restricted markdown (##, -, **, > example lines)
  createdAt DateTime @default(now())

  @@index([pair, order])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

// A learner meets far more cards than any audit script reads, so they are the
// best detector of a wrong gloss left in the data. One report = one card the
// reporter judged wrong, with their own words for what is wrong with it.
model ErrorReport {
  id        String   @id @default(cuid())
  userId    String
  // The card being shown. Kept nullable so a report survives a word deletion.
  wordId    String?
  pair      String
  // What the learner was doing: "TYPING", "QCM", "READING"… — a wrong gloss and
  // a wrong example sentence are not the same bug
  context   String?
  // Copy of the term and translation as displayed, so the report stays readable
  // after the entry is corrected
  shownTerm String?
  shownTranslation String?
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word? @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([resolved, createdAt])
}

// One row per learner per day, holding everything the chat needs to throttle:
// how many turns they have spent today, and when the last one was. Counting
// stored messages instead would mean a scan on the hot path, and the chat
// deliberately keeps no transcript.
model ChatUsage {
  id            String    @id @default(cuid())
  userId        String
  day           String // "YYYY-MM-DD", UTC — a shifted boundary costs nothing to an abuse cap
  messageCount  Int       @default(0)
  lastMessageAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model UserWord {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  // "SV_FR" = prompted in Swedish, answered in French | "FR_SV" = the reverse.
  // Each direction has its own SM-2 progression.
  direction      String    @default("SV_FR")
  // SM-2 fields
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  nextReview     DateTime  @default(now())
  // Stats
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  approxCount    Int       @default(0)
  lastResult     String?   // "correct" | "approximate" | "incorrect"
  lastStudied    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId, direction])
}

model StudySession {
  id           String    @id @default(cuid())
  userId       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  wordsStudied Int       @default(0)
  wordsCorrect Int       @default(0)
  wordsApprox  Int       @default(0)
  xpGained     Int       @default(0)
  bestCombo    Int       @default(0)
  // Set only on a session played offline and replayed later: the phone resends
  // until the server confirms, and this is what makes the retry a no-op.
  offlineBatch String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offlineBatch], map: "StudySession_userId_offlineBatch_key")
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xpReward    Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

// Asynchronous duel between two learners of the same content pair. Nobody
// plays at the same time: one takes their round, the turn passes, the other
// answers the same round number on their OWN words — drawn at their own CEFR
// level, so an A2 and a B2 can meet without either being served the other's
// vocabulary. Only self-corrected exercises are used (no flashcard), so a
// score is a fact rather than a self-assessment.
model Duel {
  id        String @id @default(cuid())
  pair      String // both players study this pair (lib/courses.ts)
  direction String // both play the same translation direction
  mode      String @default("CLASSIC") // "CLASSIC" | "BLITZ" — see lib/duel/rules.ts
  rounds    Int    @default(5) // best-of N
  // "ACTIVE" | "FINISHED" | "DECLINED" — a challenge is accepted by playing it
  status    String @default("ACTIVE")

  challengerId String
  opponentId   String
  // Round wins, not points: a round goes to whoever scored highest in it
  challengerWins Int @default(0)
  opponentWins   Int @default(0)
  // Whose move it is, null once the duel is over
  turnUserId String?
  // Round number the turn holder has to play
  currentRound Int @default(1)
  winnerId   String? // null on a draw or while running
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  finishedAt DateTime?

  challenger User        @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User        @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  duelRounds DuelRound[]

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([turnUserId])
}

// One player's take on one round. `score` is the game score (lib/duel/rules.ts),
// unrelated to XP: XP and SM-2 go through the StudySession the round created,
// exactly like a solo session.
model DuelRound {
  id       String @id @default(cuid())
  duelId   String
  userId   String
  round    Int
  score    Int    @default(0)
  correct  Int    @default(0)
  approx   Int    @default(0)
  wrong    Int    @default(0)
  // The solo session this round was played as — its XP is the round's XP
  sessionId String?
  playedAt DateTime @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duelId, userId, round])
  @@index([duelId, round])
}

// Web Push endpoint of one device. A learner has one per browser they play on,
// and the whole feature is optional: with no VAPID keys configured the app
// never asks and never sends (see lib/push.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One finished week, and who topped it on XP earned during it. Written once the
// week is over and never recomputed, so a title cannot be taken back by a later
// change to the ranking. Ties all win: the key is [week, user], not the week.
model WeeklyWin {
  id        String   @id @default(cuid())
  userId    String
  // Monday of the week won, in the contest timezone (lib/weekly.ts)
  weekStart DateTime @db.Date
  xp        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weekStart, userId])
  @@index([userId])
}
