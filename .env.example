# Database — Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Conversation libre — clé Groq (console.groq.com), partagée avec les autres projets
GROQ_API_KEY="gsk_..."

# Second fournisseur pour la conversation, GRATUIT : Cloudflare Workers AI sert le
# même Llama 3.3 70B, ~200 tours/jour dans l'allocation gratuite. Utilisé seulement
# quand Groq est saturé ou en panne. Facultatif — sans ces deux variables, le
# fournisseur est simplement sauté.
CLOUDFLARE_ACCOUNT_ID="..."
CLOUDFLARE_API_TOKEN="..."

# Troisième fournisseur, payant et facultatif (openrouter.ai)
OPENROUTER_API_KEY="sk-or-..."

# Notifications de duel (Web Push) — entièrement facultatif. Sans ces clés,
# l'app ne demande jamais la permission et n'envoie rien ; les duels marchent
# quand même, avec le badge dans la barre de navigation.
# Générer la paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:toi@example.com"
