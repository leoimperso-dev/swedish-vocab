# Database — Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Emails transactionnels (lien « mot de passe oublié ») via le relais SMTP Brevo
# (Brevo > SMTP & API > SMTP). Sans BREVO_SMTP_KEY, le lien est écrit dans la
# console serveur au lieu d'être envoyé — le reste de l'app fonctionne.
# EMAIL_FROM doit être un expéditeur vérifié dans Brevo.
BREVO_SMTP_USER="xxxxxx@smtp-brevo.com"
BREVO_SMTP_KEY="xsmtpsib-..."
EMAIL_FROM="toi@example.com"
EMAIL_FROM_NAME="Svenska"

# Conversation libre — clé Groq (console.groq.com), partagée avec les autres projets
GROQ_API_KEY="gsk_..."

# Second fournisseur pour la conversation, GRATUIT : Cloudflare Workers AI sert le
# même Llama 3.3 70B, ~200 tours/jour dans l'allocation gratuite. Utilisé seulement
# quand Groq est saturé ou en panne. Facultatif — sans ces deux variables, le
# fournisseur est simplement sauté.
CLOUDFLARE_ACCOUNT_ID="..."
CLOUDFLARE_API_TOKEN="..."

# Troisième fournisseur, payant et facultatif (openrouter.ai)
OPENROUTER_API_KEY="sk-or-..."

# Notifications de duel (Web Push) — entièrement facultatif. Sans ces clés,
# l'app ne demande jamais la permission et n'envoie rien ; les duels marchent
# quand même, avec le badge dans la barre de navigation.
# Générer la paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:toi@example.com"

# Translating the example sentences Tatoeba left without a French counterpart
# (scripts/translate-examples.ts). Free keys end in ":fx" and use another host.
DEEPL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"

# ---------------------------------------------------------------------------
# Voix de synthèse côté serveur (facultatif mais fortement recommandé)
#
# iOS n'expose jamais ses voix Siri aux pages web : sur iPhone l'app est donc
# coincée avec une voix médiocre que le réglage ne peut pas changer. Générer
# l'audio côté serveur une bonne fois règle ça pour tous les appareils, et le
# son reste disponible hors ligne une fois téléchargé.
#
# Sans ces variables, rien ne casse : l'app parle avec la voix de l'appareil.
#
# 1. Un fournisseur de synthèse. Azure d'abord s'il est présent, sinon Google.
#    Azure : portal.azure.com > Speech service > Keys and Endpoint.
#    Le palier gratuit F0 couvre 500 000 caractères de voix neurale par mois.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="westeurope"
# GOOGLE_TTS_API_KEY=""

# 2. Le stockage des MP3 : un bucket PUBLIC nommé "tts" dans Supabase Storage.
#    L'URL est celle du projet (Settings > API), la clé est la service_role.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
